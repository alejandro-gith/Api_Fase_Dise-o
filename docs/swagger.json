        "tags": [
          "Cobros"
        ],
        "summary": "Obtener el ticket de un cobro",
        "operationId": "obtenerTicket",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Consulta ObtenerTicketDeCobro. Pantalla de Caja.",
        "parameters": [
          {
            "name": "id",
