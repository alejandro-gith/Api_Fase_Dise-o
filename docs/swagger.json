        "responses": {
          "200": {
            "description": "Datos del ticket",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe el pedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cierre-caja": {
      "get": {
        "tags": [
          "Cierre de caja"
        ],
        "summary": "Historial de cierres de caja",
        "operationId": "listarCierres",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cierres ordenados del más reciente al más antiguo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CierreCaja"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Cierre de caja"
        ],
        "summary": "Registrar cierre de caja",
        "operationId": "registrarCierreCaja",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Comando RegistrarCierreCaja. Pantalla de Administrador. La diferencia (totalContado menos totalSistema) la calcula el servidor.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CierreCajaRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cierre registrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CierreCaja"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/retroalimentacion": {
      "get": {
        "tags": [
          "Retroalimentación"
        ],
        "summary": "Historial de calificaciones de la app",
        "operationId": "listarRetroalimentacion",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Calificaciones ordenadas de la más reciente a la más antigua",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Retroalimentacion"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Retroalimentación"
        ],
        "summary": "Calificar la app",
        "operationId": "registrarRetroalimentacion",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Comando RegistrarRetroalimentacion. Calificación de 1 a 5 estrellas con comentario opcional. Disponible en todas las pantallas.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetroalimentacionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Calificación registrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Retroalimentacion"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Número de control o contraseña incorrectos"
          }
        },
        "required": [
          "error"
        ]
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "El número de control debe ser numérico"
            ]
          }
        },
        "required": [
          "errors"
        ]
      },
      "RolEmpleado": {
        "type": "string",
        "enum": [
          "admin",
          "cajero",
          "mesero"
        ]
      },
      "EstadoComanda": {
        "type": "string",
        "enum": [
          "abierta",
          "en_preparacion",
          "lista",
          "cerrada",
          "cancelada"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "noControl",
          "contrasena"
        ],
        "properties": {
          "noControl": {
            "type": "string",
            "example": "1"
          },
          "contrasena": {
            "type": "string",
