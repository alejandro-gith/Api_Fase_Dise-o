{
  "openapi": "3.0.3",
  "info": {
    "title": "Tacomanda API",
    "version": "1.0.0",
    "description": "API REST de Tacomanda, sistema de comandas del restaurante Tacos Angy.\n\nArquitectura: Clean Architecture + CQRS + SOLID sobre ASP.NET Core. Cada operación de escritura es un Comando (Controller, Command, Validator, Handler, Repository) y cada lectura es una Consulta.\n\nEste documento es el contrato de la fase de diseño. La identidad de quien opera (número de control) se toma siempre del token JWT, nunca del cuerpo de la petición."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Servidor local de desarrollo (ajustar al puerto que muestre dotnet run)"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Platillos"
    },
    {
      "name": "Mesas"
    },
    {
      "name": "Comandas"
    },
    {
      "name": "Cobros"
    },
    {
      "name": "Cierre de caja"
    },
    {
      "name": "Retroalimentación"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Iniciar sesión",
        "operationId": "login",
        "security": [],
        "description": "Comando IniciarSesion. Valida el formato, verifica la contraseña y devuelve un token JWT con el rol del empleado.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesión iniciada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Datos con formato inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Número de control o contraseña incorrectos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/platillos": {
      "get": {
        "tags": [
          "Platillos"
        ],
        "summary": "Listar platillos",
        "operationId": "listarPlatillos",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Consulta ListarPlatillos. La usan las pantallas de Administrador y Mesero.",
        "responses": {
          "200": {
            "description": "Lista de platillos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Platillo"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Platillos"
        ],
        "summary": "Crear platillo",
        "operationId": "crearPlatillo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Comando CrearPlatillo. Pantalla de Administrador.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlatilloRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Platillo creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Platillo"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/platillos/{id}": {
      "put": {
        "tags": [
          "Platillos"
        ],
        "summary": "Actualizar platillo",
        "operationId": "actualizarPlatillo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Comando ActualizarPlatillo. También sirve para activar o desactivar un platillo.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlatilloRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Platillo actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Platillo"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe el platillo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Platillos"
        ],
        "summary": "Eliminar platillo",
        "operationId": "eliminarPlatillo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Comando EliminarPlatillo. Si el platillo ya aparece en alguna comanda no se puede borrar y se recomienda desactivarlo.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Platillo eliminado"
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe el platillo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "El platillo tiene comandas asociadas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/mesas": {
      "get": {
        "tags": [
          "Mesas"
        ],
        "summary": "Listar mesas",
        "operationId": "listarMesas",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Consulta ListarMesas. La usa la pantalla de Mesero.",
        "responses": {
          "200": {
            "description": "Lista de mesas ordenadas por número",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Mesa"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/comandas": {
      "get": {
        "tags": [
          "Comandas"
        ],
        "summary": "Listar comandas",
        "operationId": "listarComandas",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Consulta de comandas. Sin filtro regresa todas; con estado filtra. La usan Cocina (tablero) y Caja (comandas por cobrar).",
        "parameters": [
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/EstadoComanda"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de comandas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Comanda"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Comandas"
        ],
        "summary": "Enviar comanda",
        "operationId": "enviarComanda",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Comando EnviarComanda. Pantalla de Mesero. El número de control del mesero se toma del token y los precios los calcula el servidor.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnviarComandaRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Comanda creada en estado abierta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComandaCreada"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe la mesa o algún platillo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/comandas/{id}": {
      "get": {
        "tags": [
          "Comandas"
        ],
        "summary": "Obtener una comanda",
        "operationId": "obtenerComanda",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de la comanda",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Comanda"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe la comanda",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/comandas/{id}/estado": {
      "put": {
        "tags": [
          "Comandas"
        ],
        "summary": "Avanzar el estado de una comanda",
        "operationId": "avanzarEstadoComanda",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Comando AvanzarEstadoDeComanda. Pantalla de Cocina. La transición válida es abierta, en_preparacion, lista, sin saltos.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EstadoComandaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estado actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Comanda"
                }
              }
            }
          },
          "400": {
            "description": "Estado inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe la comanda",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Transición no permitida o comanda ya cerrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/comandas/{id}/cobrar": {
      "post": {
        "tags": [
          "Cobros"
        ],
        "summary": "Cobrar una comanda",
        "operationId": "cobrarComanda",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Comando CobrarComanda. Pantalla de Caja. Solo se puede cobrar una comanda en estado lista. El total y el cambio los calcula el servidor y se consultan en el ticket.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CobroRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cobro registrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CobroRegistrado"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o monto insuficiente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe la comanda",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "La comanda no está lista o ya fue cobrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/pedidos/{id}/ticket": {
